---
// Interactive version of the Homelab diagram. Clicking a part explains it, and
// walkthroughs step through how a request, deploy, log line, chat message, or
// backup moves through the system. Content lives in homelab-explorer.ts.
import { intro, nodes, walkthroughs } from './homelab-explorer';

const platform = ['flux', 'argocd', 'envoy', 'prometheus', 'alloy', 'loki', 'grafana', 'llm', 'webui'];
const apps = [
  { id: 'flipfinder', note: 'flipfinder.localhost' },
  { id: 'hello-crud', note: 'hello-crud.localhost' },
  { id: 'any-app', note: 'its own namespace and hostname' },
];
const hostParts = ['browser', 'gpu', 'models', 'backups'];
---

<figure class="explorer" data-explorer>
  <div class="controls" role="group" aria-label="Walkthroughs">
    <button type="button" class="mode" data-walkthrough="explore" aria-pressed="true">Explore</button>
    {
      walkthroughs.map((w) => (
        <button type="button" class="mode" data-walkthrough={w.id} aria-pressed="false">
          {w.label}
        </button>
      ))
    }
  </div>

  <div class="panel" aria-live="polite">
    <p class="panel-meta">{intro.meta}</p>
    <p class="panel-title">{intro.title}</p>
    <p class="panel-body">{intro.body}</p>
    <div class="panel-nav" hidden>
      <button type="button" class="step-button" data-prev>Back</button>
      <button type="button" class="step-button step-button--next" data-next>Next</button>
    </div>
  </div>

  <div class="diagram">
    <div class="box github">
      <p class="box-head static">GitHub</p>
      <div class="row">
        {
          ['homelab-repo', 'app-repos'].map((id) => (
            <button type="button" class="node" data-node={id} data-select={id}>
              {nodes[id].label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="box host" data-node="host">
      <button type="button" class="box-head" data-select="host">
        Ubuntu host <span>set up with Ansible</span>
      </button>

      <div class="box docker" data-node="docker">
        <button type="button" class="box-head" data-select="docker">Docker</button>

        <div class="box kind" data-node="kind">
          <button type="button" class="box-head" data-select="kind">
            Kind cluster <span>3 nodes, each a Docker container</span>
          </button>

          <div class="group">
            <p class="group-head">
              <span class="group-name">Platform</span>
              <span>managed by Flux</span>
            </p>
            <div class="row">
              {
                platform.map((id) => (
                  <button
                    type="button"
                    class:list={['node', { gpu: id === 'llm' }]}
                    data-node={id}
                    data-select={id}
                  >
                    {nodes[id].label}
                  </button>
                ))
              }
            </div>
          </div>

          <div class="group">
            <p class="group-head">
              <span class="group-name">Applications</span>
              <span>deployed by Argo CD</span>
            </p>
            <div class="apps">
              {
                apps.map((app) => (
                  <button
                    type="button"
                    class:list={['node', 'app', { any: app.id === 'any-app' }]}
                    data-node={app.id}
                    data-select={app.id}
                  >
                    <strong>{nodes[app.id].label}</strong>
                    <span>{app.note}</span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        {
          hostParts.map((id) => (
            <button type="button" class="node" data-node={id} data-select={id}>
              {nodes[id].label}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</figure>

<script>
  import { intro, nodes, walkthroughs, type Walkthrough } from './homelab-explorer';

  for (const root of document.querySelectorAll<HTMLElement>('[data-explorer]')) {
    const targets = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>('[data-node]').forEach((el) => {
      targets.set(el.dataset.node!, el);
    });
    const modeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-walkthrough]')];
    const meta = root.querySelector<HTMLElement>('.panel-meta')!;
    const title = root.querySelector<HTMLElement>('.panel-title')!;
    const body = root.querySelector<HTMLElement>('.panel-body')!;
    const nav = root.querySelector<HTMLElement>('.panel-nav')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;

    let walkthrough: Walkthrough | null = null;
    let step = 0;
    let selected: string | null = null;

    const render = () => {
      for (const button of modeButtons) {
        const id = button.dataset.walkthrough;
        const pressed = walkthrough ? id === walkthrough.id : id === 'explore';
        button.setAttribute('aria-pressed', String(pressed));
      }

      for (const el of targets.values()) {
        el.classList.remove('is-active', 'is-visited', 'is-dim', 'is-selected');
        delete el.dataset.step;
      }

      if (walkthrough) {
        // Earlier steps keep their number so the path stays readable.
        const visited = new Map<string, number>();
        walkthrough.steps.slice(0, step).forEach((s, i) => {
          s.nodes.forEach((id) => visited.set(id, i + 1));
        });
        const current = walkthrough.steps[step];
        for (const [id, el] of targets) {
          if (current.nodes.includes(id)) {
            el.classList.add('is-active');
            el.dataset.step = String(step + 1);
          } else if (visited.has(id)) {
            el.classList.add('is-visited');
            el.dataset.step = String(visited.get(id));
          } else {
            el.classList.add('is-dim');
          }
        }

        const last = walkthrough.steps.length - 1;
        meta.textContent = `Step ${step + 1} of ${walkthrough.steps.length}`;
        title.textContent = walkthrough.title;
        body.textContent = current.text;
        nav.hidden = false;
        prev.disabled = step === 0;
        next.textContent = step === last ? 'Start over' : 'Next';
        return;
      }

      nav.hidden = true;
      const info = selected ? nodes[selected] : null;
      if (selected && info) targets.get(selected)?.classList.add('is-selected');
      meta.textContent = info ? info.group : intro.meta;
      title.textContent = info ? info.label : intro.title;
      body.textContent = info ? info.body : intro.body;
    };

    const move = (delta: number) => {
      if (!walkthrough) return;
      const count = walkthrough.steps.length;
      step = delta > 0 && step === count - 1 ? 0 : Math.max(0, Math.min(count - 1, step + delta));
      render();
    };

    root.addEventListener('click', (event) => {
      const target = (event.target as Element).closest<HTMLElement>(
        '[data-select], [data-walkthrough], [data-prev], [data-next]'
      );
      if (!target) return;

      if (target.dataset.select) {
        walkthrough = null;
        selected = target.dataset.select;
      } else if (target.dataset.walkthrough) {
        walkthrough = walkthroughs.find((w) => w.id === target.dataset.walkthrough) ?? null;
        selected = null;
        step = 0;
      } else if (target.hasAttribute('data-prev')) {
        return move(-1);
      } else if (target.hasAttribute('data-next')) {
        return move(1);
      }
      render();
    });

    root.addEventListener('keydown', (event) => {
      if (!walkthrough || event.altKey || event.ctrlKey || event.metaKey) return;
      if (event.key === 'ArrowRight') move(1);
      if (event.key === 'ArrowLeft') move(-1);
    });
  }
</script>

<style>
  .explorer {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    font-size: 0.9375rem;
  }

  button {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  p {
    margin: 0;
  }

  /* Walkthrough picker */

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .mode {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
    transition:
      color 150ms ease,
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .mode:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .mode[aria-pressed='true'] {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }

  /* Explanation panel */

  .panel {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-height: 9.5rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .panel-meta {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .panel-title {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .panel-body {
    color: var(--muted);
    line-height: 1.55;
  }

  .panel-nav {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .panel-nav[hidden] {
    display: none;
  }

  .step-button {
    padding: 0.3125rem 0.875rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .step-button:hover:not(:disabled) {
    border-color: var(--text);
  }

  .step-button:disabled {
    cursor: default;
    opacity: 0.45;
  }

  .step-button--next {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }

  /* Diagram */

  .diagram {
    display: grid;
    gap: 0.625rem;
  }

  .box {
    position: relative;
    display: grid;
    gap: 0.625rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .github,
  .host {
    background: var(--surface);
    border-color: var(--border-strong);
  }

  .docker {
    background: var(--surface-2);
  }

  .kind {
    gap: 0.875rem;
    background: var(--surface);
    border-style: dashed;
    border-color: var(--border-strong);
  }

  .box-head {
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-align: left;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition:
      opacity 200ms ease,
      text-decoration-color 150ms ease;
  }

  .box-head:not(.static):hover {
    text-decoration-color: var(--border-strong);
  }

  .box-head span {
    margin-left: 0.375rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .group {
    display: grid;
    gap: 0.5rem;
  }

  .group-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 1rem;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .group-name {
    color: var(--accent-text);
    font-weight: 500;
  }

  /* Extra room so step badges don't cover neighboring nodes. */
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 0.5rem;
  }

  .apps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 0.5rem;
  }

  .node {
    position: relative;
    padding: 0.3125rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface-2);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    text-align: left;
    transition:
      opacity 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .node:hover {
    border-color: var(--border-strong);
  }

  .node.gpu {
    padding-left: 0.8125rem;
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .app {
    display: grid;
    gap: 0.125rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .app strong {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .app span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .app.any {
    border-style: dashed;
    border-color: var(--border-strong);
    background: transparent;
  }

  .app.any strong {
    color: var(--muted);
    font-weight: 500;
  }

  /* States set by the script */

  .is-selected,
  .is-active {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .node.gpu.is-selected,
  .node.gpu.is-active {
    box-shadow:
      inset 3px 0 0 var(--accent),
      0 0 0 1px var(--accent);
  }

  .is-visited {
    border-color: var(--border-strong);
  }

  /* Dim leaf nodes directly, but only the heading of a box, so an active node
     inside a dimmed box stays at full strength. */
  .node.is-dim,
  .box.is-dim > .box-head {
    opacity: 0.35;
  }

  [data-step]::after {
    content: attr(data-step);
    position: absolute;
    top: -0.5rem;
    right: -0.5rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
  }

  .is-visited[data-step]::after {
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--muted);
  }

  @media (max-width: 34rem) {
    .box {
      padding: 0.5rem;
    }
  }
</style>
