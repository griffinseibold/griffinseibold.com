---
import { site } from '../site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container row">
    <p>© {year} {site.name}</p>
    <ul>
      <li><a class="link" href={site.links.linkedin} rel="me">LinkedIn</a></li>
      <li><a class="link" href={site.links.github} rel="me">GitHub</a></li>
      {
        site.email && (
          <li>
            <a class="link" href={`mailto:${site.email}`}>
              Email
            </a>
          </li>
        )
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 2rem;
    color: var(--faint);
    font-size: 0.875rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link {
    color: var(--muted);
  }
</style>
